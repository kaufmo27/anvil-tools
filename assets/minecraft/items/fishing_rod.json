{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
            "when": "Overgrown Fishing Rod",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/overgrown_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/overgrown_fishing_rod_cast"
            }
          }
        },
        {
            "when": "Заросла Вудка",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/overgrown_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/overgrown_fishing_rod_cast"
            }
          }
        },
        {
            "when": "Bone Fishing Rod",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/bone_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/bone_fishing_rod_cast"
            }
          }
        },
        {
            "when": "Кістяна Вудка",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/bone_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/bone_fishing_rod_cast"
            }
          }
        },
        {
            "when": "Blossom Fishing Rod",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/blossom_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/blossom_fishing_rod_cast"
            }
          }
        },
        {
            "when": "Квітуча Вудка",
            "model": {
            "type": "minecraft:condition",
            "property": "minecraft:fishing_rod/cast",
            "on_false": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/blossom_fishing_rod"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "item/fishing_rods/blossom_fishing_rod_cast"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:fishing_rod/cast",
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/fishing_rod"
        },
        "on_true": {
          "type": "minecraft:model",
          "model": "minecraft:item/fishing_rod_cast"
        }
      }
    },

    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:fishing_rod/cast",
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/fishing_rod_cast"
      }
    }
  }
}